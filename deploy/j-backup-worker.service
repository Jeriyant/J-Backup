[Unit]
Description=J-BACKUP queue and schedule worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jbackup
Group=jbackup
Environment="JBACKUP_DATA_DIR=@@DATA_DIR@@"
Environment="JBACKUP_REALTIME_DIR=@@REALTIME_DIR@@"
Environment="JBACKUP_BACKUP_DIR=@@BACKUP_DIR@@"
WorkingDirectory=@@APP_DIR_SYSTEMD@@
ExecStart=/usr/bin/php "@@APP_DIR@@/bin/worker.php"
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths="@@DATA_DIR@@" "@@REALTIME_DIR@@" "@@BACKUP_DIR@@" "@@LOG_DIR@@"
UMask=0007
